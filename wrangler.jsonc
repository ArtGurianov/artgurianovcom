{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artgurianovcom",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artgurianovcom-db",
      "database_id": "016ebd0e-f1f4-490e-8894-f17896602887"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "next-tag-cache",
      "database_id": "016ebd0e-f1f4-490e-8894-f17896602887"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "7ab5d99f1c68403cb8e926cd664f43eb"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_LOCALE": "en-US",
    "NEXT_PUBLIC_RECAPTCHA_PUBLIC_KEY": "6LfkvfwqAAAAAOzQpf62kHVmul5Zii5CIPWYOHoC"
  }
}
