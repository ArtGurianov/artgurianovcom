// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Use one by one when prototyping initial database with the command:
// $npx prisma db push
// After both steps are done, it doesn't matter which url stays here
// since they both get overwritten in PrismaClient constructor
//
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model EmailSubscription {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  email         String          @unique
  locale        String
  fromRouteId   String
  device        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  applicationType     APPLICATION_TYPE
  name                String
  codingLevel         EXPERIENCE_LEVEL?
  entrepreneurLevel   EXPERIENCE_LEVEL?
  contactBy           CONTACT_BY
  contact             String
  locale              String
  device              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique(name: "uniqueContact", [applicationType, contactBy, contact])
}

enum CONTACT_BY {
  EMAIL
  PHONE
  TG
}

enum EXPERIENCE_LEVEL {
  NONE
  SOME
  GURU
}

enum APPLICATION_TYPE {
  MENTORSHIP
  RECRUIT
  STUDIO
}
