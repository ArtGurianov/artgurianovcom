// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model EmailSubscription {
  id          String @id @default(cuid())
  email       String @unique
  locale      String
  fromRouteId String
  device      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id                String           @id @default(cuid())
  applicationType   APPLICATION_TYPE
  name              String
  codingLevel       EXPERIENCE_LEVEL?
  entrepreneurLevel EXPERIENCE_LEVEL?
  contactBy         CONTACT_BY
  contact           String
  locale            String
  device            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique(name: "uniqueContact", [applicationType, contactBy, contact])
}

enum CONTACT_BY {
  EMAIL
  PHONE
  TG
}

enum EXPERIENCE_LEVEL {
  NONE
  SOME
  GURU
}

enum APPLICATION_TYPE {
  MENTORSHIP
  RECRUIT
  STUDIO
}
